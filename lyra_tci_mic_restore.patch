diff --git a/src/tci_server.cpp b/src/tci_server.cpp
--- a/src/tci_server.cpp
+++ b/src/tci_server.cpp

@@ HUNK 1 — save mic source before the TCI auto-flip on keydown @@
 
 Context (around line 1696 — the useTciAudio block that calls setMicSource):
 
-                if (useTciAudio && prefs_)
-                    prefs_->setMicSource(QStringLiteral("tci"));
+                if (useTciAudio && prefs_) {
+                    // Save the pre-flip token so we can restore it on keyup,
+                    // but only when the auto-restore pref is on AND the source
+                    // is not already "tci" (nothing to restore in that case).
+                    if (prefs_->tciRestoreMicSource()
+                            && prefs_->micSource() != QLatin1String("tci")) {
+                        preMicSource_ = prefs_->micSource();
+                    } else {
+                        preMicSource_.clear();
+                    }
+                    prefs_->setMicSource(QStringLiteral("tci"));
+                }

@@ HUNK 2 — restore on normal TCI keyup (trx:0,false path) @@

 Context (around line 1759 — the "wantsTx == false" block):
 
         if (txAudioOwner_ == ws) {
             txAudioOwner_ = nullptr;
             chronoOutstanding_ = 0;
             chronoTimer_->stop();
             emit statusMessage(
                 QStringLiteral("TCI: TX-audio ownership RELEASED"));
         }
-        // TX-rip Phase 1 (Q2): R-H2 keyup-restore returns with the
-        // new TX DSP worker per docs/TX_ARCHITECTURAL_MAPPING.md §10.3.
+        // Auto-restore mic source on keyup when the pref is on and
+        // we saved a pre-flip token at keydown time.
+        if (prefs_ && !preMicSource_.isEmpty()) {
+            prefs_->setMicSource(preMicSource_);
+            preMicSource_.clear();
+            emit statusMessage(QStringLiteral(
+                "TCI: mic source restored to: ") + prefs_->micSource());
+        }
         stream_->requestMoxFromTci(false);

@@ HUNK 3 — restore on client disconnect while TX is active @@

 Context (around line 560 — the txAudioOwner_ cleanup in onClientDisconnected):

         if (ws == txAudioOwner_) {
             txAudioOwner_ = nullptr;
             chronoOutstanding_ = 0;
             chronoTimer_->stop();
             emit statusMessage(QStringLiteral(
                 "TCI: TX-audio ownership released (client disconnected)"));
             if (stream_) stream_->requestMoxFromTci(false);
-            // TX-rip Phase 1 (Q2): R-H2 activeMicSource_ save/restore
-            // returns with the new TX DSP worker per
-            // docs/TX_ARCHITECTURAL_MAPPING.md §10.3.
+            // Restore mic source when owner disconnects mid-TX — same
+            // logic as the normal keyup path.
+            if (prefs_ && !preMicSource_.isEmpty()) {
+                prefs_->setMicSource(preMicSource_);
+                preMicSource_.clear();
+                emit statusMessage(QStringLiteral(
+                    "TCI: mic source restored (owner disconnect) to: ")
+                    + prefs_->micSource());
+            }
         }

@@ HUNK 4 — restore on wire MOX drop in onMoxActiveChanged @@

 Context (around line 1110 — after the txAudioOwner_ cleanup for external MOX drop):

     if (was && was->state() == QAbstractSocket::ConnectedState) {
         sendTo(was, QStringLiteral("trx:0,false"));
     }
+    // Restore mic source on external MOX drop (e.g. operator presses
+    // MOX button while a TCI session is active) — covers the edge case
+    // where the TCI client never sends trx:0,false itself.
+    if (prefs_ && !preMicSource_.isEmpty()) {
+        prefs_->setMicSource(preMicSource_);
+        preMicSource_.clear();
+        emit statusMessage(QStringLiteral(
+            "TCI: mic source restored (external MOX drop) to: ")
+            + prefs_->micSource());
+    }
 }

