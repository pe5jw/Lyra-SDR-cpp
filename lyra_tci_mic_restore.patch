diff --git a/src/prefs.h b/src/prefs.h
--- a/src/prefs.h
+++ b/src/prefs.h
@@ ... @@ (after the micSource Q_PROPERTY block, around line 336)
+    // When enabled, TCI-driven keydowns save the previous mic-source
+    // token and restore it on PTT release.  Persisted: tx/tci_restore_mic_source.
+    // Default false — existing dedicated-digital setups are unaffected.
+    Q_PROPERTY(bool tciRestoreMicSource
+               READ  tciRestoreMicSource
+               WRITE setTciRestoreMicSource
+               NOTIFY tciRestoreMicSourceChanged)

@@ ... @@ (public accessor section, after micSourceTooltip, around line 583)
+    bool tciRestoreMicSource() const { return tciRestoreMicSource_; }
+    void setTciRestoreMicSource(bool on);

@@ ... @@ (signals section, after micSourceChanged, around line 604 area)
+    void tciRestoreMicSourceChanged();

@@ ... @@ (private members section, after micSource_ declaration, around line 798)
+    bool    tciRestoreMicSource_ = false;  // tx/tci_restore_mic_source

