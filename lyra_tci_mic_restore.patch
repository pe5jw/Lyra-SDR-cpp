diff --git a/src/tci_server.h b/src/tci_server.h
--- a/src/tci_server.h
+++ b/src/tci_server.h
@@ ... @@ (private members section, near txAudioOwner_)
+    // Token saved at TCI keydown when tciRestoreMicSource pref is on.
+    // Empty string = nothing to restore (pref was off, or source was
+    // already "tci" before keydown — no flip happened).
+    QString preMicSource_;

