diff --git a/src/prefs.cpp b/src/prefs.cpp
--- a/src/prefs.cpp
+++ b/src/prefs.cpp
@@ ... @@ (constexpr keys block, after kMicSource, around line 105)
+constexpr auto kTciRestoreMicSource = "tx/tci_restore_mic_source";

@@ ... @@ (load() section, after the micSource load, around line 294)
+    tciRestoreMicSource_ =
+        s.value(kTciRestoreMicSource, false).toBool();

@@ ... @@ (after setMicSource(), around line 1255 area — add new setter)
+void Prefs::setTciRestoreMicSource(bool on) {
+    if (on == tciRestoreMicSource_) return;
+    tciRestoreMicSource_ = on;
+    QSettings().setValue(kTciRestoreMicSource, on);
+    emit tciRestoreMicSourceChanged();
+}

